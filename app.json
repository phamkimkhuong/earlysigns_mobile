{
  "expo": {
    "name": "EarlySigns",
    "slug": "earlysigns",
    "owner": "phamkhuong436",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "earlysigns",
    "ios": {
      "bundleIdentifier": "net.earlysigns.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "EarlySigns records your voice to check English pronunciation.",
        "NSCameraUsageDescription": "EarlySigns uses the camera to scan text for pronunciation practice.",
        "NSPhotoLibraryUsageDescription": "EarlySigns uses your photos to scan text for pronunciation practice.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "net.earlysigns.app",
      "adaptiveIcon": {
        "backgroundColor": "#e0f4fd",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "EarlySigns records your voice to check English pronunciation."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "EarlySigns uses your photos to scan text for pronunciation practice.",
          "cameraPermission": "EarlySigns uses the camera to scan text for pronunciation practice."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#e0f4fd"
        }
      ],
      "expo-asset",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#256392"
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "react-native-fbsdk-next",
        {
          "appID": "000000000000000",
          "clientToken": "00000000000000000000000000000000",
          "displayName": "EarlySigns",
          "scheme": "fb000000000000000"
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/3e87d6c1-9158-4efe-9a34-8da11d90a19f"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "3e87d6c1-9158-4efe-9a34-8da11d90a19f"
      }
    }
  }
}
